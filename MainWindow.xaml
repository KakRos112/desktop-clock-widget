<Window x:Class="ClockWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jam Desktop"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual"
        UseLayoutRounding="True">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Pengaturan…" Click="OnMenuSettings"/>
            <Separator/>
            <MenuItem Header="Keluar" Click="OnMenuExit"/>
        </ContextMenu>
    </Window.ContextMenu>

    <!-- Latar hampir transparan supaya seluruh area bisa diseret -->
    <Border x:Name="Root" Background="#01000000" Padding="16" Cursor="SizeAll">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="Zoom"/>
        </Border.LayoutTransform>
        <StackPanel>
            <StackPanel.Effect>
                <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="1" Opacity="0.65"/>
            </StackPanel.Effect>
            <StackPanel x:Name="TimeHost" Orientation="Horizontal"/>
            <Canvas x:Name="Analog" Width="220" Height="220" Visibility="Collapsed"/>
            <TextBlock x:Name="DateText" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="18"/>
        </StackPanel>
    </Border>
</Window>
